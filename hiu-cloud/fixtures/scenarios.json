[
  {
    "name": "login shows the captcha image and persists the token",
    "pageId": "main",
    "mocks": [
      {
        "capability": "network.request",
        "input": {
          "url": "https://jxypt.hiu.edu.cn/api/ykt-basics/oauth/captcha",
          "purpose": "auth",
          "headers": {
            "accept": "application/json"
          }
        },
        "result": {
          "ok": true,
          "data": {
            "status": 200,
            "url": "https://jxypt.hiu.edu.cn/api/ykt-basics/oauth/captcha",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\"code\":200,\"success\":true,\"data\":{\"key\":\"ck-1\",\"image\":\"data:image/png;base64,ZmFrZQ==\"}}"
          }
        }
      },
      {
        "capability": "files.create",
        "input": {
          "name": "captcha.png",
          "mime": "image/png"
        },
        "result": {
          "ok": true,
          "data": {
            "handle": "f1",
            "name": "captcha.png",
            "mime": "image/png",
            "size": 4
          }
        }
      },
      {
        "capability": "files.write",
        "input": {
          "handle": "f1",
          "base64": "ZmFrZQ=="
        },
        "result": {
          "ok": true,
          "data": {
            "handle": "f1",
            "name": "captcha.png",
            "mime": "image/png",
            "size": 4
          }
        }
      },
      {
        "capability": "network.request",
        "input": {
          "url": "https://jxypt.hiu.edu.cn/api/ykt-basics/oauth/token",
          "method": "POST",
          "purpose": "auth",
          "headers": {
            "accept": "application/json"
          },
          "form": {
            "grant_type": "password",
            "scope": "all",
            "client_id": "portal",
            "client_secret": "portal_secret",
            "tenantId": "000000",
            "username": "demo01",
            "password": "e10adc3949ba59abbe56e057f20f883e",
            "captcha": "ck-1:1236"
          }
        },
        "result": {
          "ok": true,
          "data": {
            "status": 200,
            "url": "https://jxypt.hiu.edu.cn/api/ykt-basics/oauth/token",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\"code\":200,\"data\":{\"token_type\":\"bearer\",\"access_token\":\"tok-1\",\"expires_in\":7200}}"
          }
        }
      }
    ],
    "steps": [
      {
        "expect": {
          "state": {
            "screen": "login",
            "pending": ""
          },
          "nodes": {
            "captcha": {
              "type": "image"
            }
          }
        }
      },
      {
        "event": {
          "type": "input",
          "nodeId": "user",
          "name": "user",
          "value": "demo01"
        }
      },
      {
        "event": {
          "type": "input",
          "nodeId": "pass",
          "name": "pass",
          "value": "123456"
        }
      },
      {
        "event": {
          "type": "input",
          "nodeId": "code",
          "name": "code",
          "value": "1236"
        }
      },
      {
        "event": {
          "type": "click",
          "nodeId": "login",
          "name": "login"
        },
        "expect": {
          "state": {
            "screen": "home",
            "pending": "",
            "who": "demo01"
          },
          "nodes": {
            "status": {
              "textContains": "已登录"
            }
          }
        }
      }
    ]
  },
