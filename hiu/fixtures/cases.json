[
  {
    "name": "Captcha challenge on start",
    "operation": "auth.start",
    "args": {
      "username": "fictional123",
      "password": "fictional-password"
    },
    "http": [
      {
        "url": "https://jwxt.hiu.edu.cn/jsxsd/verifycode.servlet",
        "purpose": "auth",
        "response": {
          "url": "https://jwxt.hiu.edu.cn/jsxsd/verifycode.servlet",
          "status": 200,
          "headers": {
            "Content-Type": "image/jpeg"
          },
          "body": "ZmFrZS1qcGVnLWJhc2U2NA=="
        }
      }
    ],
    "capture": "start",
    "expectSubset": {
      "ok": true,
      "data": {
        "status": "captcha",
        "mimeType": "image/jpeg"
      }
    }
  },
  {
    "name": "Refresh captcha keeps continuation",
    "operation": "auth.refreshCaptcha",
    "args": {
      "continuationId": {
        "$ref": "start.continuationId"
      }
    },
    "http": [
      {
        "url": "https://jwxt.hiu.edu.cn/jsxsd/verifycode.servlet",
        "purpose": "auth",
        "response": {
          "url": "https://jwxt.hiu.edu.cn/jsxsd/verifycode.servlet",
          "status": 200,
          "headers": {
            "Content-Type": "image/png"
          },
          "body": "ZmFrZS1wbmctYmFzZTY0"
        }
      }
    ],
    "expectSubset": {
      "ok": true,
      "data": {
        "status": "captcha",
        "mimeType": "image/png"
      }
    }
  },
  {
    "name": "Login with captcha reaches identity in a single request",
    "operation": "auth.resume",
    "args": {
      "continuationId": {
        "$ref": "start.continuationId"
      },
      "captcha": "1234"
    },
    "http": [
      {
        "url": "https://jwxt.hiu.edu.cn/jsxsd/xk/LoginToXk",
        "purpose": "auth",
        "method": "POST",
        "response": {
          "url": "https://jwxt.hiu.edu.cn/jsxsd/framework/xsMain.htmlx",
          "status": 200,
          "headers": {},
          "body": "<div>学期理论课表</div><div class=\"userInfo\"><p style=\"font-weight: 500;\">模拟同学</p><span style=\"font-size: 12px;color:#888888\">学生</span></div><a>退出登录</a>"
        }
      }
    ],
    "expect": {
      "ok": true,
      "data": {
        "status": "authenticated",
        "studentId": "fictional123",
        "studentName": "模拟同学"
      }
    }
  },
  {
    "name": "Expired continuation",
    "operation": "auth.resume",
    "args": {
      "continuationId": "expired"
    },
    "expect": {
      "ok": false,
      "error": {
        "code": "SESSION_EXPIRED",
        "message": "登录验证已过期，请重新开始"
      }
    }
  },
  {
    "name": "Second start issues a fresh continuation",
    "operation": "auth.start",
    "args": {
      "username": "fictional123",
      "password": "fictional-password"
    },
    "http": [
      {
        "url": "https://jwxt.hiu.edu.cn/jsxsd/verifycode.servlet",
        "purpose": "auth",
        "response": {
          "url": "https://jwxt.hiu.edu.cn/jsxsd/verifycode.servlet",
          "status": 200,
          "headers": {
            "Content-Type": "image/jpeg"
          },
          "body": "ZmFrZS1qcGVnLWJhc2U2NA=="
        }
      }
    ],
    "capture": "restart",
    "expectSubset": {
      "ok": true,
      "data": {
        "status": "captcha",
        "mimeType": "image/jpeg"
      }
    }
  },
  {
    "name": "Resume falls back to profile page when the login response lacks identity",
    "operation": "auth.resume",
    "args": {
      "continuationId": {
        "$ref": "restart.continuationId"
      },
      "captcha": "1234"
    },
    "http": [
      {
        "url": "https://jwxt.hiu.edu.cn/jsxsd/xk/LoginToXk",
        "purpose": "auth",
        "method": "POST",
        "response": {
          "url": "https://jwxt.hiu.edu.cn/jsxsd/framework/xsMain.htmlx",
          "status": 200,
          "headers": {},
          "body": "<div>学期理论课表</div><a>退出登录</a>"
        }
      },
      {
        "url": "https://jwxt.hiu.edu.cn/jsxsd/grsz/grsz_xggrxx.do?type=dlym",
        "purpose": "query",
        "response": {
          "url": "https://jwxt.hiu.edu.cn/jsxsd/grsz/grsz_xggrxx.do?type=dlym",
          "status": 200,
          "headers": {},
          "body": "<input name=\"account\" id=\"account\" value=\"fictional123\"/><input name=\"realName\" id=\"realName\" value=\"模拟同学\"/>"
        }
      }
    ],
    "expect": {
      "ok": true,
      "data": {
        "status": "authenticated",
        "studentId": "fictional123",
        "studentName": "模拟同学"
      }
    }
  },
  {
    "name": "Expired refresh",
    "operation": "auth.refreshCaptcha",
    "args": {
      "continuationId": "expired"
    },
    "expect": {
      "ok": false,
      "error": {
        "code": "SESSION_EXPIRED",
        "message": "登录验证已过期，请重新开始"
      }
    }
  },
  {
